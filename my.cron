# fx-signal-engine scheduled jobs (added 2026-08-16, repathed 2026-09-01)
# Repo moved out of iCloud to ~/dev/fx-signal-engine.
# Install:  crontab "/Users/nickrowles-davies/dev/fx-signal-engine/my.cron"
# View:     crontab -l
# Remove:   crontab -r
#
# Jobs call the venv python directly rather than run.sh, so they keep working
# even if a tracked-file change to run.sh is stashed by a scheduled task.
#
# The generators take an exclusive tree lock (repo_lock.py). Cron waits for a
# holder rather than skipping the run, since a missed scheduled job is worse
# than a late one. Reinstall after editing:  crontab my.cron
LEVANTER_LOCK_WAIT=180
#
# 4h paper trial: check every 4 hours, act when a new 4h bar has closed.
0 */4 * * * cd "/Users/nickrowles-davies/dev/fx-signal-engine" && .venv/bin/python paper_trade.py --once >> reports/cron.log 2>&1
# Carry overlay: rebalance once a month (06:30 on the 1st).
30 6 1 * * cd "/Users/nickrowles-davies/dev/fx-signal-engine" && .venv/bin/python carry_signal.py >> reports/cron.log 2>&1
# Crypto momentum: weekly signal (Mondays 07:00).
0 7 * * 1 cd "/Users/nickrowles-davies/dev/fx-signal-engine" && .venv/bin/python crypto_signal.py >> reports/cron.log 2>&1
# Combined portfolio tracker: weekly (Mondays 07:15).
15 7 * * 1 cd "/Users/nickrowles-davies/dev/fx-signal-engine" && .venv/bin/python combined_tracker.py >> reports/cron.log 2>&1
# Vol-targeted basket tracker: weekly (Mondays 07:20).
20 7 * * 1 cd "/Users/nickrowles-davies/dev/fx-signal-engine" && .venv/bin/python vol_basket_tracker.py >> reports/cron.log 2>&1
# (Dashboard auto-regeneration is handled by serve.sh's background loop while
#  the phone server is running - no separate cron needed.)
